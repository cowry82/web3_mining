# BitUP 区块链挖矿系统环境变量配置文件
# 复制此文件为 .env 并填入真实的配置信息

# 钱包配置
# EVM链私钥（ETH、BSC、POLYGON使用十六进制私钥）
PRIVATE_KEY=your_private_key_here
# EVM链钱包地址
WALLET_ADDRESS=your_wallet_address_here

# Solana私钥（使用Base58编码）
SOLANA_PRIVATE_KEY=your_solana_private_key_here
# Solana钱包地址
SOLANA_ADDRESS=your_solana_address_here

# 智能合约地址
# 以太坊挖矿合约地址
ETH_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# BSC主网挖矿合约地址
BSC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# BSC测试网挖矿合约地址（用于调试和测试）
BSC_TESTNET_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Polygon挖矿合约地址
POLYGON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Solana挖矿程序ID
SOLANA_CONTRACT_ADDRESS=11111111111111111111111111111111

# API密钥（可选，用于获取更好的RPC服务）
# Alchemy API密钥
ALCHEMY_API_KEY=your_alchemy_api_key_here
# Infura API密钥
INFURA_API_KEY=your_infura_api_key_here

# 网络配置
# 默认使用的区块链网络（ETH/BSC/BSC_TESTNET/POLYGON/SOLANA）
# BSC_TESTNET为BSC测试网，适合开发和调试
DEFAULT_CHAIN=BSC_TESTNET

# 是否启用演示模式（false=使用真实链上数据，true=使用模拟数据）
# 注意：如果没有配置私钥，系统会自动进入演示模式
DEMO_MODE=true